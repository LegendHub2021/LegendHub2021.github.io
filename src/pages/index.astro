---
import "../styles/coming-soon.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Legend is building something new. The official Legend platform is coming soon." />
    <meta name="theme-color" content="#070707" />
    <link rel="icon" type="image/png" href="/assets/legend-profile.png" />
    <link rel="canonical" href="https://legendofgamer.com/" />
    <title>Coming Soon — Legend</title>
  </head>
  <body class="coming-soon-body">
    <main class="coming-soon">
      <div class="coming-soon__atmosphere" aria-hidden="true"></div>
      <section class="coming-soon__content" aria-labelledby="coming-soon-title">
        <div class="coming-soon__warden-art">
          <img class="coming-soon__warden-image" src="/assets/legend-warden-banner.png" alt="A shadowed close-up of Legend wearing the signature mask" width="1325" height="216" />
        </div>
        <p class="coming-soon__brand">LEGEND</p>
        <h1 id="coming-soon-title">Coming Soon</h1>
        <p class="coming-soon__message">Something new is taking shape.</p>
        <nav class="coming-soon__socials" aria-label="Follow Legend">
          <a href="https://www.youtube.com/legendofgamer" target="_blank" rel="noopener noreferrer" aria-label="Legend on YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg>
          </a>
          <a href="https://www.instagram.com/ReallegendOG" target="_blank" rel="noopener noreferrer" aria-label="Legend on Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.1 2h9.8A5.1 5.1 0 0 1 22 7.1v9.8a5.1 5.1 0 0 1-5.1 5.1H7.1A5.1 5.1 0 0 1 2 16.9V7.1A5.1 5.1 0 0 1 7.1 2Zm-.2 2A2.9 2.9 0 0 0 4 6.9v10.2A2.9 2.9 0 0 0 6.9 20h10.2a2.9 2.9 0 0 0 2.9-2.9V6.9A2.9 2.9 0 0 0 17.1 4H6.9Zm10.7 1.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM12 6.9a5.1 5.1 0 1 1 0 10.2 5.1 5.1 0 0 1 0-10.2Zm0 2a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Z"/></svg>
          </a>
          <a href="https://www.twitch.tv/LegendOfGamer" target="_blank" rel="noopener noreferrer" aria-label="Legend on Twitch">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 2h19v13.2l-5.4 5.4h-4.1L9.8 24H6.5v-3.4H2V5L3 2Zm1.2 2-.7 2v12h4.8v2.6l2.6-2.6h4.8l4.1-4.1V4H4.2Zm5.3 3h2.2v6.2H9.5V7Zm5.8 0h2.2v6.2h-2.2V7Z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@reallegendog" target="_blank" rel="noopener noreferrer" aria-label="Legend on TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 2c.3 2.5 1.7 4 4.2 4.2v3.6a9.2 9.2 0 0 1-4.2-1v7.1a6.1 6.1 0 1 1-5.2-6v3.7a2.5 2.5 0 1 0 1.6 2.3V2h3.6Z"/></svg>
          </a>
        </nav>
      </section>
    </main>
  </body>
</html>
